{
  "$defs": {
    "EditEvent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "wiki": {
          "const": "enwiki",
          "title": "Wiki",
          "type": "string"
        },
        "title": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "old_revision_id": {
          "exclusiveMinimum": 0,
          "title": "Old Revision Id",
          "type": "integer"
        },
        "revision_id": {
          "exclusiveMinimum": 0,
          "title": "Revision Id",
          "type": "integer"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        }
      },
      "required": [
        "wiki",
        "title",
        "old_revision_id",
        "revision_id",
        "occurred_at"
      ],
      "title": "EditEvent",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "before": {
          "maxLength": 4096,
          "title": "Before",
          "type": "string"
        },
        "after": {
          "maxLength": 4096,
          "title": "After",
          "type": "string"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "const": "https://en.wikipedia.org/w/api.php",
          "default": "https://en.wikipedia.org/w/api.php",
          "title": "Endpoint",
          "type": "string"
        },
        "page_id": {
          "exclusiveMinimum": 0,
          "title": "Page Id",
          "type": "integer"
        },
        "from_title": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "\\S",
          "title": "From Title",
          "type": "string"
        },
        "to_title": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "\\S",
          "title": "To Title",
          "type": "string"
        },
        "source_url": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "page_id",
        "from_title",
        "to_title",
        "source_url"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "event": {
      "$ref": "#/$defs/EditEvent"
    },
    "source": {
      "enum": [
        "wikipedia",
        "fixture"
      ],
      "title": "Source",
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "no_text_change",
        "evidence_limit",
        "revision_unavailable",
        "rate_limited",
        "upstream_unavailable",
        "http_error",
        "timeout",
        "network_error",
        "invalid_response",
        "provenance_mismatch",
        "unsupported_diff",
        "response_too_large",
        "deadline_exceeded"
      ],
      "title": "Status",
      "type": "string"
    },
    "attempts": {
      "maximum": 2,
      "minimum": 0,
      "title": "Attempts",
      "type": "integer"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/Provenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 20,
      "title": "Evidence",
      "type": "array"
    },
    "content_truncated": {
      "default": false,
      "title": "Content Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "event",
    "source",
    "status",
    "attempts"
  ],
  "title": "EnrichmentResult",
  "type": "object"
}
