{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "wiki": {
      "const": "enwiki",
      "title": "Wiki",
      "type": "string"
    },
    "title": {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Title",
      "type": "string"
    },
    "old_revision_id": {
      "exclusiveMinimum": 0,
      "title": "Old Revision Id",
      "type": "integer"
    },
    "revision_id": {
      "exclusiveMinimum": 0,
      "title": "Revision Id",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    }
  },
  "required": [
    "wiki",
    "title",
    "old_revision_id",
    "revision_id",
    "occurred_at"
  ],
  "title": "EditEvent",
  "type": "object"
}
