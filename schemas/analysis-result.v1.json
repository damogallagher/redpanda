{
  "$defs": {
    "EditEvent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "wiki": {
          "const": "enwiki",
          "title": "Wiki",
          "type": "string"
        },
        "title": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "old_revision_id": {
          "exclusiveMinimum": 0,
          "title": "Old Revision Id",
          "type": "integer"
        },
        "revision_id": {
          "exclusiveMinimum": 0,
          "title": "Revision Id",
          "type": "integer"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        }
      },
      "required": [
        "wiki",
        "title",
        "old_revision_id",
        "revision_id",
        "occurred_at"
      ],
      "title": "EditEvent",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "before": {
          "maxLength": 4096,
          "title": "Before",
          "type": "string"
        },
        "after": {
          "maxLength": 4096,
          "title": "After",
          "type": "string"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "title": "Evidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "event": {
      "$ref": "#/$defs/EditEvent"
    },
    "analysis_version": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Analysis Version",
      "type": "string"
    },
    "backend": {
      "enum": [
        "ollama",
        "openai"
      ],
      "title": "Backend",
      "type": "string"
    },
    "model": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Model",
      "type": "string"
    },
    "prompt_version": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Prompt Version",
      "type": "string"
    },
    "decision": {
      "enum": [
        "routine",
        "review",
        "insufficient_evidence"
      ],
      "title": "Decision",
      "type": "string"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "explanation": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Explanation",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "maxItems": 20,
      "title": "Evidence",
      "type": "array"
    },
    "attempts": {
      "maximum": 4,
      "minimum": 0,
      "title": "Attempts",
      "type": "integer"
    },
    "latency_ms": {
      "minimum": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "content_truncated": {
      "title": "Content Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "event",
    "analysis_version",
    "backend",
    "model",
    "prompt_version",
    "decision",
    "confidence",
    "explanation",
    "evidence",
    "attempts",
    "latency_ms",
    "content_truncated"
  ],
  "title": "AnalysisResult",
  "type": "object"
}
