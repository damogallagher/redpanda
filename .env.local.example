# Copy to .env.local; edit this profile, not the generated .env.
# Both profiles must share a project name and database password to reuse data.
COMPOSE_PROJECT_NAME=redpanda
COMPOSE_FILE=docker-compose.yml
LLM_BACKEND=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://ollama:11434
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1024
OLLAMA_MODEL=qwen2.5:7b
OPENAI_API_KEY=
POSTGRES_PASSWORD=local-development-only
CONNECT_PORT=4195
INGEST_SAMPLE_ALL=false
