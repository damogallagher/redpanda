# Copy to .env.local; edit this profile, not the generated .env.
# Both profiles must share a project name and database password to reuse data.
COMPOSE_PROJECT_NAME=redpanda
COMPOSE_FILE=docker-compose.yml
LLM_BACKEND=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://ollama:11434
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1024
OLLAMA_MODEL=qwen2.5:7b
OPENAI_API_KEY=
POSTGRES_PASSWORD=local-development-only
CONNECT_PORT=4195
INGEST_SAMPLE_ALL=false

# Worker stops after this many edits; 0 runs continuously (hosted calls incur charges).
WORKER_MAX_ITEMS=10
KAFKA_GROUP_ID=triage-v1

# Results API and storage sink (loopback ports only).
API_PORT=8000
SINK_PORT=4196
SINK_GROUP_ID=triage-store-v1
