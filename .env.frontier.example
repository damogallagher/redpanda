# Copy to .env.frontier; add your own API key before starting.
# Both profiles must share a project name and database password to reuse data.
COMPOSE_PROJECT_NAME=redpanda
COMPOSE_FILE=compose.infrastructure.yml
LLM_BACKEND=openai
LLM_MODEL=gpt-6.1-sol
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1024
OPENAI_API_KEY=
POSTGRES_PASSWORD=local-development-only
CONNECT_PORT=4195
INGEST_SAMPLE_ALL=false

# Worker stops after this many edits; 0 runs continuously (hosted calls incur charges).
WORKER_MAX_ITEMS=10
KAFKA_GROUP_ID=triage-v1

# Results API and storage sink (loopback ports only).
API_PORT=8000
SINK_PORT=4196
SINK_GROUP_ID=triage-store-v1

# Separate database roles. Local-only defaults; choose distinct random values on shared hosts.
# Re-running the launcher reconciles these passwords without resetting stored results.
TRIAGE_READER_PASSWORD=local-reader-only
TRIAGE_WRITER_PASSWORD=local-writer-only
