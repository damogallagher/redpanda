# Manual-start example. Prefer .env.local.example / .env.frontier.example and scripts/start-*.sh.
# Copy to .env only for manual setup; never commit credentials.
# Default docker compose up also starts live Wikimedia ingestion.
LLM_BACKEND=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://ollama:11434
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1024

# Hosted alternative: edit the three LLM settings above, then use compose.infrastructure.yml.
# LLM_BACKEND=openai
# LLM_MODEL=gpt-6.1-sol
# LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Native Ollama alternative (must have this model pulled on the host):
# LLM_BASE_URL=http://host.docker.internal:11434

# Local Docker model bootstrap only; independent of the hosted model choice.
OLLAMA_MODEL=qwen2.5:7b
# Development-only password; database is not published on a host port.
POSTGRES_PASSWORD=local-development-only

# Connect metrics/readiness bind to localhost only.
CONNECT_PORT=4195
# Default accepts candidate revisions divisible by 100 (deterministic 1% selection).
# Set true only for an intentional ingestion demo or fixture run; this increases candidates for model processing.
INGEST_SAMPLE_ALL=false

# Worker stops after this many edits; 0 runs continuously (hosted calls incur charges).
WORKER_MAX_ITEMS=10
KAFKA_GROUP_ID=triage-v1

# Results API and storage sink (loopback ports only).
API_PORT=8000
SINK_PORT=4196
SINK_GROUP_ID=triage-store-v1

# Separate database roles. Local-only defaults; choose distinct random values on shared hosts.
# Re-running the launcher reconciles these passwords without resetting stored results.
TRIAGE_READER_PASSWORD=local-reader-only
TRIAGE_WRITER_PASSWORD=local-writer-only
