# Copy to .env; never commit credentials. These settings select inference only.
# Default docker compose up starts local infrastructure plus Ollama/model download.
LLM_BACKEND=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://ollama:11434
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=1024

# Hosted alternative: edit the three LLM settings above, then use compose.infrastructure.yml.
# LLM_BACKEND=openai
# LLM_MODEL=gpt-6.1-sol
# LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Native Ollama alternative (must have this model pulled on the host):
# LLM_BASE_URL=http://host.docker.internal:11434

# Local Docker model bootstrap only; independent of the hosted model choice.
OLLAMA_MODEL=qwen2.5:7b
# Development-only password; database is not published on a host port.
POSTGRES_PASSWORD=local-development-only
